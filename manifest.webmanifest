{
 "name": "Piccadilly Drivers",
 "short_name": "Piccadilly Drivers",
 "start_url": "/agr-drivers/",
 "scope": "/agr-drivers/",
 "display": "standalone",
 "background_color": "#0b1020",
 "theme_color": "#003688",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "share_target": {
  "action": "/agr-drivers/share",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "files": [
    {
     "name": "pdfs",
     "accept": [
      "application/pdf",
      ".pdf",
      "application/zip",
      ".zip"
     ]
    }
   ]
  }
 },
 "id": "/agr-drivers/"
}